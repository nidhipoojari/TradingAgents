# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=

# SEC EDGAR (US company filings, point-in-time). No key; a contact address SEC can reach you at.
#SEC_EDGAR_USER_AGENT=Your Name your@email.com

# FRED (Federal Reserve macro data). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# TypeSafe Jev: screens StockTwits and Reddit posts for the Sentiment Analyst. Optional.
#TYPESAFE_API_KEY=
#TYPESAFE_DEFAULT_MODEL=jev-latest
#TYPESAFE_BASE_URL=https://openrouter.ai/api   # Jev through OpenRouter, with an OpenRouter key above

# Custom OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp). Local servers need no key.
#OPENAI_COMPATIBLE_API_KEY=

# AWS Bedrock (pip install ".[bedrock]"). Bearer token, or the AWS credential chain; set the region either way.
#AWS_BEARER_TOKEN_BEDROCK=
#AWS_DEFAULT_REGION=us-west-2
#AWS_PROFILE=

# ChatGPT Plus or Pro plan: no key; sign in once with `tradingagents login chatgpt`.
#TRADINGAGENTS_LLM_PROVIDER=chatgpt

# Remote Ollama server. Unset uses http://localhost:11434/v1.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Override these DEFAULT_CONFIG keys. Provider, models, language and round counts also skip their CLI prompt.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
# E1: backup model per tier, used when the main model fails (429, 5xx, bad name).
# Leave empty for no backup. Switches are logged to <results_dir>/e1_fallback_log.txt
#TRADINGAGENTS_DEEP_FALLBACK_LLM=gemini-3.5-flash-lite
#TRADINGAGENTS_QUICK_FALLBACK_LLM=gemini-3.5-flash-lite
# E2: reuse past-dated market data from <data_cache_dir>/e2_cache.sqlite (delete the file to clear it)
#TRADINGAGENTS_E2_CACHE=true

# F1 (Phase 3): Alpaca PAPER-trading keys for the dashboard (pip install ".[dashboard]").
# Only the paper endpoint is ever used; a live URL or ALPACA_PAPER=false is refused.
#ALPACA_API_KEY=
#ALPACA_SECRET_KEY=
# Largest order value (USD) a person may approve: quantity x limit price (limit orders only). Default 1000.
#TRADINGAGENTS_MAX_ORDER_NOTIONAL=1000
# Paper orders need a signed-in approver (default true). Password sign-in reads this users file
# of scrypt hashes: make an entry with `python -m tradingagents.execution.identity hash-password`.
#TRADINGAGENTS_REQUIRE_ORDER_AUTH=true
#TRADINGAGENTS_DASHBOARD_USERS=/path/to/dashboard_users.json
# Server-side dashboard sessions and persistent sign-in limits (SQLite, mode 0600). Default: <results_dir>/dashboard_auth.sqlite
#TRADINGAGENTS_AUTH_DB=
# Dashboard and MCP analyses run in a worker process; on cancel it gets this long to stop before it is terminated.
#TRADINGAGENTS_CANCEL_GRACE_SECONDS=10
# inline = run analyses in the server process (no termination on cancel). Default: process.
#TRADINGAGENTS_ANALYSIS_WORKER=process
# A worker must report ready within this many seconds (else it is replaced, once); one silent this long during a run is terminated.
#TRADINGAGENTS_WORKER_READY_TIMEOUT=60
#TRADINGAGENTS_WORKER_HEARTBEAT_TIMEOUT=30
# Longest wait for a Langfuse flush when an E3 summary is saved (the outcome is recorded in the summary).
#E3_FLUSH_TIMEOUT_SECONDS=10
# F2 (Phase 3): MCP server (pip install ".[mcp]"). stdio is the recommended local transport.
# http needs a token (16+ chars) and binds to 127.0.0.1; another address needs --allow-remote,
# --tls-cert/--tls-key and a 32+ character token.
#TRADINGAGENTS_MCP_TOKEN=
#TRADINGAGENTS_MCP_TIMEOUT_SECONDS=900
#TRADINGAGENTS_MCP_MAX_REPORT_CHARS=4000
# MCP runs keep their own memory log; unset puts it beside the main one as mcp_trading_memory.md.
#TRADINGAGENTS_MCP_MEMORY_LOG_PATH=

# A tier on its own provider (set its model above too); its URL only for a local or relay endpoint.
#TRADINGAGENTS_DEEP_THINK_PROVIDER=
#TRADINGAGENTS_QUICK_THINK_PROVIDER=
#TRADINGAGENTS_DEEP_THINK_BACKEND_URL=
#TRADINGAGENTS_QUICK_THINK_BACKEND_URL=
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_MAX_TOOL_ROUNDS=20
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Turn off the start-up note about a newer release and Tauric Research notices.
#TRADINGAGENTS_NO_UPDATE_CHECK=1

# Docker: a host folder for results, reports and the memory log (unset: the tradingagents_data volume).
#TRADINGAGENTS_DATA_DIR=./data

# Paths and alpha benchmark. Unset uses ~/.tradingagents and the regional index.
#TRADINGAGENTS_RESULTS_DIR=
#TRADINGAGENTS_CACHE_DIR=
#TRADINGAGENTS_MEMORY_LOG_PATH=
#TRADINGAGENTS_BENCHMARK_TICKER=SPY

# Lower temperature means less run-to-run variation on models that honor it.
#TRADINGAGENTS_TEMPERATURE=0.0

# Retry budget for every LLM SDK. Raise it to ride out 429 throttling.
#TRADINGAGENTS_LLM_MAX_RETRIES=6

# Cap output tokens to bound a model that runs long and trips a timeout.
#TRADINGAGENTS_MAX_TOKENS=8192

# Reasoning depth per provider; setting one skips its prompt.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high
